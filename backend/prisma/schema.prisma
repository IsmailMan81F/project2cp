generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SensorReading {
  id        String   @id @default(cuid())
  entityId  String
  value     Float
  unit      String   @default("°C")
  timestamp DateTime @default(now())
  rawData   Json?

  @@index([entityId, timestamp])
  @@index([timestamp])
}
